{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/portal",
      "destination": "https://silver-cattle-791431.hostingersite.com/webhook/portal"
    },
    {
      "source": "/cliente",
      "destination": "https://silver-cattle-791431.hostingersite.com/webhook/portal"
    },
    {
      "source": "/webhook/:path*",
      "destination": "https://silver-cattle-791431.hostingersite.com/webhook/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=600"
        }
      ]
    }
  ]
}
